# ──────────────────────────────────────────────
# AWS Bedrock Configuration
# ──────────────────────────────────────────────

AWS_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_API_KEY=your-long-term-api-key

# Retry & Timeout
BEDROCK_MAX_RETRIES=2
BEDROCK_TIMEOUT_SECONDS=30

# Model inference parameters
BEDROCK_MAX_TOKENS=700
BEDROCK_TEMPERATURE=0.05
BEDROCK_TOP_P=0.9

APP_ENV=development
VITE_API_BASE_URL=/api